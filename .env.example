# Copy to .env and fill in. Every variable the app reads is listed here.

# Postgres connection. With `docker compose up -d db` use the values below.
# Without Docker, run `npm run db:dev` in web/ and use its printed URL (port 54329).
DATABASE_URL=postgresql://homeward:homeward@127.0.0.1:5432/homeward

# Compose reads these for the db service.
POSTGRES_USER=homeward
# Change this before you expose the app. The default is only for a first try on a trusted LAN.
POSTGRES_PASSWORD=homeward
POSTGRES_DB=homeward
# Host port for the database (bound to 127.0.0.1 only).
DB_PORT=5432

# Required. Random, at least 32 characters. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app.
BETTER_AUTH_URL=http://localhost:3000
# Anyone who can reach the app can create an account while this is true.
# Set it to false as soon as everyone in the home has one.
ALLOW_SIGNUP=true
# Optional. Other addresses you open the app from, comma separated,
# for example http://192.168.1.20:3000 . BETTER_AUTH_URL is always allowed.
TRUSTED_ORIGINS=

# Set to true only if a reverse proxy you control sits in front of the app and sets
# X-Forwarded-For. Leave it false otherwise: the login rate limit then ignores that header.
TRUSTED_PROXY=false

# Optional. A free NVD key raises the limit from 5 to 50 requests per 30 seconds.
NVD_API_KEY=
# Daily re-check time, 5-field cron, in the time zone below.
RESCAN_CRON=0 3 * * *
# Time zone for RESCAN_CRON, for example Europe/Amsterdam.
TZ=UTC
# Largest SBOM upload in megabytes.
MAX_SBOM_MB=20

# Where the worker keeps the Trivy database (set in the image).
# TRIVY_CACHE_DIR=/var/cache/trivy

# Test only (not needed to run the app). Point the worker at a stub or fake binary.
# NVD_BASE_URL=https://services.nvd.nist.gov
# KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
# TRIVY_PATH=trivy

# Names the images that `docker compose up -d --build` creates. Only needed to pull released
# images instead of building. Same tag for web and worker.
# HOMEWARD_OWNER=your-github-name
# HOMEWARD_TAG=latest
